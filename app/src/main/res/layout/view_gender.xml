<?xml version="1.0" encoding="utf-8"?>
<!-- Patient gender picker (avatar only). Used by the add-medicine form and the patient dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/genderLabel"
        style="@style/SettingsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gender_label"
        android:textAlignment="viewStart"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/genderGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:selectionRequired="false"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/maleButton"
            style="@style/Widget.PillPals.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:text="@string/gender_male" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/femaleButton"
            style="@style/Widget.PillPals.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:text="@string/gender_female" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/genderError"
        style="@style/FormError"
        android:text="@string/err_gender" />
</LinearLayout>
