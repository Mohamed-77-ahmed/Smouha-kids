<?xml version="1.0" encoding="utf-8"?>
<!-- The PIN sheet above (or beside) the keypad: badge, title, message, step, dots, status. Mirrors in RTL. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/badge"
        android:layout_width="@dimen/pin_badge_size"
        android:layout_height="@dimen/pin_badge_size"
        android:background="@drawable/bg_lock_circle"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_lock"
        app:tint="@color/on_gradient" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textDirection="firstStrong"
        tools:text="@string/add_medicine" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textDirection="firstStrong"
        tools:text="@string/pin_msg_add" />

    <TextView
        android:id="@+id/stepLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:text="@string/pin_step"
        tools:visibility="visible" />

    <!-- Filled when a digit is typed; read out as "N digits entered". -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityLiveRegion="polite"
        android:focusable="true"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:layoutDirection="ltr"
        android:minHeight="24dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:minLines="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="@string/pin_checking" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/checking"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:visibility="gone" />
</LinearLayout>
