<?xml version="1.0" encoding="utf-8"?>
<!-- Fade-through, outgoing screen: fades out quickly. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="90"
    android:fromAlpha="1"
    android:interpolator="@android:interpolator/accelerate_cubic"
    android:toAlpha="0" />
