    <!-- About -->
    <string name="about_title">About the app</string>
    <string name="about_intro">A medicine reminder for the patients of Smouha University Children\'s Hospital and their families. It reminds at the right time and celebrates every pill that is taken.</string>
    <string name="about_disclaimer_title">Important</string>
    <string name="about_disclaimer">This app is a reminder tool only. It gives no medical advice and no doses. Always follow the doctor\'s instructions.</string>
    <string name="about_privacy_title">Data</string>
    <string name="about_privacy">Everything stays on this phone only. The app has no internet access and sends nothing anywhere.</string>
    <string name="section_erase">Erase data</string>
    <string name="erase_desc">Deletes all patients, medicines, points, streaks and the parent PIN from this phone. Reminders stop and the app starts again from the language choice. This cannot be undone.</string>
    <string name="erase_button">Erase all data</string>
    <string name="erase_confirm_title">Erase everything?</string>
